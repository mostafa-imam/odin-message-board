<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/global.css">
    <title>Odin Message Board</title>
  </head>
  <body>
    <main class="main-index">
        <a href="/new" class="join-btn">Join the conversation</a>

        <ul>
            <% locals.messages.forEach( ( message ) => { %>
                <li>
                    <div>
                        <span class="message-user">@<%= message.user %></span>
                        <span>&bull;</span>
                        <span class="message-date"><%= message.added.toLocaleDateString() %> <%= message.added.getHours() %>:<%= message.added.getMinutes() %>:<%= message.added.getSeconds() %></span>
                        <span>&bull;</span>
                        <span><a href="/message/<%= message.id %>">open</a></span>
                    </div>
                    <p class="message-text"><%= message.text %></p>
                </li>
            <% }); %>
        </ul>
    </main>
  </body>
</html>
