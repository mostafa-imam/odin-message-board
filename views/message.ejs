<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/global.css" />
    <title>Message</title>
  </head>
  <body>
    <main>
      <nav><a href="/">Home Page</a></nav>

      <div class="message-wrapper">
        <div class="message-n-page">
          <span class="message-user">@<%= locals.message.user %></span>
          <span>&bull;</span>
          <span class="message-date">
            <%= locals.message.added.toLocaleDateString() %> <%=
            locals.message.added.getHours() %>:<%=
            locals.message.added.getMinutes() %>:<%=
            locals.message.added.getSeconds() %>
          </span>
        </div>
        <p class="message-text"><%= locals.message.text %></p>
      </div>
    </main>
  </body>
</html>
